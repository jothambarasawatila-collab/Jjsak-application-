# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# =============================================================================
# JJSAK-AUTH-OTP-004: TRANSACTIONAL EMAIL DELIVERY PROVIDER CONFIGURATION
# =============================================================================
# Production Transactional SMTP Relay / Service
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="JJSAK Security Authority <security@jjsak.org>"

# Optional HTTP Email Provider API (Resend / SendGrid / Postmark)
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_TYPE=SMTP

# Authenticated Sender Domain Alignment (SPF, DKIM, DMARC)
EMAIL_SENDING_DOMAIN=jjsak.org
DMARC_POLICY=reject

# =============================================================================
# JJSAK-AUTH-OTP-004: PRODUCTION SMS GATEWAY CONFIGURATION
# =============================================================================
# Africa's Talking SMS Gateway (Primary for Kenya / +254 recipients)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=JJSAK-AUTH

# Alternative Production SMS Provider: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Alternative Production SMS Provider: Safaricom Bulk SMS API
SAFARICOM_SMS_API_KEY=
SAFARICOM_SMS_PARTNER_ID=
SAFARICOM_SMS_SHORTCODE=

