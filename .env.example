# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=

# =============================================================================
# JJSAK OTP AUTHENTICATION SYSTEM — PHASE 4: RESEND & AFRICA'S TALKING (JJSAK-AUTH-OTP-004D)
# =============================================================================
NODE_ENV=production
PORT=3000

# OTP Security & Expiry Configuration
OTP_LENGTH=6
OTP_VALIDITY_OWNER_SECONDS=300
OTP_VALIDITY_STAFF_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=30
OTP_LOCKOUT_MINUTES=15
OTP_SINGLE_USE=true
OTP_RETURN_CODE_IN_API=false
OTP_LOG_PLAINTEXT=false

# 1. Transactional Email Provider (Resend)
EMAIL_PROVIDER_TYPE=RESEND
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME="JJSAK Security"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="JJSAK Security Authority <security@jjsak.org>"

# 2. Kenya-Supported SMS Provider (Africa's Talking)
SMS_PROVIDER_TYPE=AFRICASTALKING
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=JJSAK-AUTH
TWILIO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# 3. Official WhatsApp Business Delivery (Meta WhatsApp Cloud API / Twilio WhatsApp)
WHATSAPP_PROVIDER_TYPE=
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_BUSINESS_ACCESS_TOKEN=

# 4. Canonical Registered Credentials
OWNER_EMAIL=
OWNER_PHONE=



